{
  "name": "pando-console",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-design.mjs",
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/vendor-design.mjs && npm run types",
    "build": "tsc --noEmit && vite build",
    "types": "go run ../cmd/gen-api-types",
    "lint": "eslint src",
    "precheck": "node scripts/vendor-design.mjs && npm run types",
    "check": "npm run lint && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "oxlint": "1.82.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
